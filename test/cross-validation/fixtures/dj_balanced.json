{
  "format": "simqc-circuit",
  "version": 1,
  "bitOrder": "little-endian",
  "numQubits": 2,
  "columns": [
    [{ "gate": "X", "target": 1 }],
    [{ "gate": "H", "target": 0 }, { "gate": "H", "target": 1 }],
    [{ "gate": "CNOT", "target": 1, "controls": [{ "row": 0, "on": true }] }],
    [{ "gate": "H", "target": 0 }]
  ]
}
